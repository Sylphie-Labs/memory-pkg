{
  "name": "@sylphie-labs/memory-pkg",
  "version": "0.5.0",
  "description": "Long-term session memory for Claude Code. Captures every transcript, indexes events in TimescaleDB, and auto-injects relevant history into every new prompt. Multi-tier retrieval with a SQL-only fast path; rationale synthesis compresses turns into searchable 'why' events at ingest.",
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "memory",
    "timescaledb",
    "pgvector",
    "agent-tooling",
    "session-memory"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Jim Tisdale",
  "homepage": "https://github.com/Sylphie-Labs/memory-pkg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sylphie-Labs/memory-pkg.git"
  },
  "bugs": {
    "url": "https://github.com/Sylphie-Labs/memory-pkg/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp-server": {
      "types": "./dist/mcp-server/index.d.ts",
      "import": "./dist/mcp-server/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./ingest": {
      "types": "./dist/ingest/ingester.d.ts",
      "import": "./dist/ingest/ingester.js"
    },
    "./inject": {
      "types": "./dist/inject/generate.d.ts",
      "import": "./dist/inject/generate.js"
    }
  },
  "bin": {
    "memory-pkg": "dist/cli/memory-pkg.js",
    "memory-pkg-mcp": "dist/mcp-server/index.js"
  },
  "files": [
    "dist/",
    "template/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepublishOnly": "rimraf dist && tsc",
    "mcp-server": "node dist/mcp-server/index.js",
    "schema:init": "node dist/schema.js",
    "ingest": "node dist/ingest/ingester.js",
    "memory": "node dist/cli/memory-pkg.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "release": "vitest run && npm publish"
  },
  "dependencies": {
    "@huggingface/transformers": "^3",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
